/* Terminal-native: no painted background, no filled selection bar. */
Screen {
    background: $background;
    color: $text;
    align: center top;
}

#shell {
    width: 100%;
    height: 100%;
    padding: 0 1;
}

#title {
    height: 3;
    padding: 1 1 0 1;
    text-style: bold;
}

#items {
    height: 1fr;
    width: 100%;
    background: $background;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: $text;
    scrollbar-background: $background;
}

ListItem {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $background;
    color: $text;
}

/* A row is either one Static, or a marker beside a body that wraps with a hanging indent. */
ListItem > Static,
ListItem > Horizontal.row-line {
    width: 100%;
    height: auto;
    background: $background;
}

Horizontal.row-line > Static {
    height: auto;
    background: $background;
}

Horizontal.row-line > .row-marker {
    width: auto;
}

Horizontal.row-line > .row-body {
    width: 1fr;
}

/* w: unwrapped rows stay on one line and end in an ellipsis. */
ListItem.unwrap Horizontal.row-line > .row-body {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ListItem.-highlight {
    background: $background;
    text-style: bold;
}

ListItem.section-row {
    margin-top: 1;
    text-style: bold;
}

ListItem.project-row {
    margin-bottom: 1;
}

ListItem.conflict-row {
    margin-bottom: 1;
}

#empty {
    height: auto;
    padding: 0 2;
    text-style: dim;
}

#prompt {
    height: 3;
    border: none;
    background: $background;
    padding: 0 2;
}

#footer {
    height: 2;
    width: 100%;
    padding: 0 1;
    text-style: dim;
    text-overflow: ellipsis;
}
