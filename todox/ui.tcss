/* Terminal-native: no painted background, no filled selection bar, only the
   terminal's own ANSI colors. Text colors live in ui.py as named ANSI styles. */
Screen {
    background: $background;
    color: $text;
    align: center top;
}

#shell {
    width: 100%;
    height: 100%;
    padding: 0 1;
}

/* Short terminals get a one-line header; tall ones a blank row above and below. */
#title {
    height: 1;
    padding: 0 1;
}

#shell.-tall #title {
    height: 3;
    padding: 1 1 0 1;
}

#body {
    height: 1fr;
}

#main {
    width: 1fr;
    height: 100%;
}

/* Projects pane, shown beside the list on wide terminals. */
#side {
    display: none;
    width: 40;
    height: 100%;
    background: $background;
    border: none;
    border-right: solid ansi_bright_black;
    scrollbar-size: 1 1;
    scrollbar-color: $text;
    scrollbar-background: $background;
}

#columns {
    display: none;
    height: 1;
    padding: 0 1;
}

#items {
    height: 1fr;
    width: 100%;
    background: $background;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: $text;
    scrollbar-background: $background;
}

ListItem {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $background;
    color: $text;
}

/* A row is either one Static, or a marker beside a body that wraps with a hanging indent. */
ListItem > Static,
ListItem > Horizontal.row-line {
    width: 100%;
    height: auto;
    background: $background;
}

Horizontal.row-line > Static {
    height: auto;
    background: $background;
}

Horizontal.row-line > .row-marker {
    width: auto;
}

Horizontal.row-line > .row-body {
    width: 1fr;
}

/* w: unwrapped rows stay on one line and end in an ellipsis. */
ListItem.unwrap Horizontal.row-line > .row-body,
ListItem.unwrap > Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ListItem.-highlight {
    background: $background;
    text-style: bold;
}

ListItem.help-row.-highlight {
    text-style: none;
}

/* Section, status and project headings get a blank row above, except at the top. */
ListItem.section-row {
    margin-top: 1;
}

ListItem.section-row:first-child {
    margin-top: 0;
}

ListItem.project-row.narrow,
ListItem.conflict-row,
ListItem.side-all {
    margin-bottom: 1;
}

#empty {
    height: auto;
    padding: 0 2;
    text-style: dim;
}

#prompt {
    height: 1;
    border: none;
    background: $background;
    padding: 0 2;
}

#footer {
    height: 1;
    width: 100%;
    padding: 0 1;
    text-overflow: ellipsis;
}

#shell.-tall #footer {
    height: 2;
    padding: 1 1 0 1;
}
