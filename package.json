{
  "name": "todox",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Markdown-native todo app for the terminal, with no UI framework",
  "type": "module",
  "bin": { "todo": "./src/cli.ts" },
  "scripts": {
    "start": "bun src/cli.ts",
    "demo": "TODOX_CONFIG=./examples/config.json bun src/cli.ts --global",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "@types/bun": "^1.3.14", "typescript": "^5.9.3" }
}
